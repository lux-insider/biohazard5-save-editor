// Cores e medidas do editor, tiradas dos menus do BIOHAZARD 5: fundo quase
// preto, painéis translúcidos sobre textura, texto cor de osso, vermelho da
// seleção e dourado dos ranks.
export global Tema {
    out property <color> fundo: #050505;
    out property <color> texto: #e4ddcc;
    out property <color> texto-2: #a39b8b;
    out property <color> desativado: #5f594f;
    out property <color> borda: #ffffff2e;
    out property <color> linha: #ffffff17;
    out property <color> cartao: #0b0b0bd9;
    out property <color> painel: #151515e6;
    out property <color> corpo-menu: #3c3c3c7f;   // tm123, linha 96
    out property <color> campo: #00000080;
    out property <color> realce: #ffffff0f;
    out property <color> azul: #6f9fcf;
    out property <color> vermelho: #c8261b;
    out property <color> vermelho-escuro: #7d120c;
    out property <color> vermelho-claro: #ff5a45;
    out property <color> verde: #7fae4e;
    out property <color> laranja: #e0913a;
    out property <color> dourado: #cfae6a;
    out property <color> selecao: #c8261b33;

    out property <length> raio: 2px;
    out property <length> raio-campo: 2px;
    // Fontes do jogo (ui/fontes): máquina de escrever no texto, serifada nos títulos.
    out property <string> fonte-texto: "BH5 Maquina";
    out property <string> fonte-titulo: "BH5 Serifa";
    out property <length> fonte: 15px;
    out property <length> fonte-pequena: 13px;
}

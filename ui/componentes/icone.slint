// Ícones originais do jogo (atlas ui/imagens/icones.png) e os ladrilhos
// escuros onde eles aparecem, no estilo do inventário do RE5.
import { Tema } from "../tema.slint";
import { Ponte, ItemOpcao } from "../ponte.slint";

// As imagens que se repetem em muitos ladrilhos, abertas uma vez só.
// Um @image-url dentro de um componente repetido abre o PNG de novo em cada
// cópia quando ele não cabe no cache de imagens do Slint (~5 MB): o atlas de
// ícones aberto tem 8 MB, e cada ladrilho ficava com a sua cópia (59 cópias,
// ~470 MB pedidos, só para abrir Personagens e Itens extras).
// São in-out de propósito: uma propriedade constante o compilador copia de
// volta para cada uso, e o PNG voltaria a ser aberto em cada ladrilho. Pelo
// mesmo motivo a global é exportada em app.slint.
export global Imagens {
    in-out property <image> icones: @image-url("../imagens/icones.png");
    in-out property <image> figuras: @image-url("../imagens/figuras.png");
    in-out property <image> armas: @image-url("../imagens/armas.png");
    in-out property <image> celula-bau: @image-url("../imagens/jogo/celula_bau.png");
    in-out property <image> celula-slot: @image-url("../imagens/jogo/celula_slot.png");
    in-out property <image> cursor: @image-url("../imagens/jogo/cursor.png");
}

// Um ícone do atlas; sem ícone (-1) mostra um marcador discreto.
export component IconeItem inherits Rectangle {
    in property <int> indice: -1;
    in property <bool> apagado: false;

    if root.indice >= 0: Image {
        width: parent.width;
        height: parent.height;
        source: Imagens.icones;
        source-clip-x: mod(root.indice, Ponte.atlas-colunas) * Ponte.atlas-celula;
        source-clip-y: floor(root.indice / Ponte.atlas-colunas) * Ponte.atlas-celula;
        source-clip-width: Ponte.atlas-celula;
        source-clip-height: Ponte.atlas-celula;
        image-fit: contain;
        opacity: root.apagado ? 0.35 : 1;
    }
    if root.indice < 0 && !root.apagado: Rectangle {
        width: parent.width * 0.46;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: #ffffff38;
        Text {
            text: "?";
            color: #ffffff60;
            font-size: parent.width * 0.55;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Célula do baú do jogo (itembox00) com o ícone; o cursor de canto cortado
// do jogo (itembox07) marca a escolhida e acende ao passar o mouse.
export component CaixaIcone inherits Rectangle {
    in property <int> indice: -1;
    in property <bool> escolhido: false;
    in property <bool> destaque: false;
    in property <bool> vazio: false;
    in property <bool> slot: false;      // célula dos slots do personagem (mais gasta)
    // menor que 1 deixa ver o fundo (no Inventário, a foto da caixa de itens)
    in property <float> opacidade-celula: 1;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.slot ? Imagens.celula-slot : Imagens.celula-bau;
        image-fit: fill;
        opacity: root.opacidade-celula;
    }
    IconeItem {
        x: parent.width * 0.08;
        y: parent.height * 0.08;
        width: parent.width * 0.84;
        height: parent.height * 0.84;
        indice: root.indice;
        apagado: root.vazio;
    }
    @children
    // Cursor do jogo: a moldura tem 113 px com o brilho; o quadrado ocupa ~85%.
    if root.escolhido || root.destaque: Image {
        x: -parent.width * 0.09;
        y: -parent.height * 0.09;
        width: parent.width * 1.18;
        height: parent.height * 1.18;
        source: Imagens.cursor;
        image-fit: fill;
        colorize: root.escolhido ? Tema.vermelho-claro : #ffffffa0;
    }
}

// Miniatura de uma Figura do jogo (cápsula do menu de Figuras, tm114).
export component IconeFigura inherits Image {
    in property <int> figura: -1;
    source: Imagens.figuras;
    source-clip-x: mod(root.figura, 10) * 96;
    source-clip-y: floor(root.figura / 10) * 96;
    source-clip-width: 96;
    source-clip-height: 96;
    image-fit: contain;
}

// Ladrilho clicável com ícone e nome embaixo (grades de escolha e catálogo).
export component Ladrilho inherits Rectangle {
    in property <ItemOpcao> item;
    in property <bool> escolhido;
    in property <length> lado: 64px;
    in property <bool> com-nome: true;
    callback clicado();

    width: root.lado;
    height: root.com-nome ? root.lado + 30px : root.lado;
    caixa := CaixaIcone {
        y: 0;
        width: root.lado;
        height: root.lado;
        indice: root.item.icone;
        escolhido: root.escolhido;
        destaque: toque.has-hover;
        vazio: root.item.icone < 0 && root.item.figura >= 0;
        // Arma sem imagem no jogo: mostra a Figura do inimigo que a usa.
        if root.item.icone < 0 && root.item.figura >= 0: IconeFigura {
            x: parent.width * 0.06;
            y: parent.height * 0.06;
            width: parent.width * 0.88;
            height: parent.height * 0.88;
            figura: root.item.figura;
        }
    }
    if root.com-nome: Text {
        y: root.lado + 3px;
        width: parent.width;
        height: 26px;
        text: root.item.nome;
        font-size: 10.5px;
        color: root.escolhido ? Tema.vermelho : Tema.texto;
        horizontal-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }
    toque := TouchArea { mouse-cursor: pointer; clicked => { root.clicado(); } }
}


// Aba "Save": faixa com a miniatura, o nome do save e a arte de Chris e Sheva;
// embaixo, cartões com o dinheiro e a data, o dono e a integridade.
// Enxuta: as explicações só aparecem quando algo não confere.
import { Tema } from "../tema.slint";
import { Ponte } from "../ponte.slint";
import { Botao, Campo } from "../componentes/basicos.slint";
import { CampoTexto } from "../componentes/controles.slint";
import { ScrollView } from "std-widgets.slint";

// Cartão escuro com título e um traço vermelho à esquerda do título.
component Cartao inherits Rectangle {
    in property <string> titulo;
    background: #0a0a0ad0;
    border-width: 1px;
    border-color: Tema.linha;
    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle { width: 3px; height: 16px; y: (parent.height - self.height) / 2; background: Tema.vermelho; }
            Text {
                text: root.titulo;
                font-family: Tema.fonte-titulo;
                font-size: 15px;
                letter-spacing: 2px;
                color: #ffffff;
                vertical-alignment: center;
            }
        }
        @children
    }
}

// Valor em destaque (Gold, Exchange Points, data): letra grande e dourada.
component ValorGrande inherits VerticalLayout {
    in-out property <string> texto;
    in property <bool> invalido;
    in property <string> ajuda;
    in property <bool> ajuda-aviso;
    in property <color> cor: Tema.dourado;
    // quantos caracteres o valor costuma ter (a letra diminui para caber)
    in property <int> letras: 9;
    callback editado();
    spacing: 4px;
    CampoTexto {
        height: 50px;
        // diminui na janela estreita para o valor caber inteiro
        tamanho-letra: min(24px, (root.width - 28px) / (root.letras * 0.75));
        cor: root.invalido ? Tema.vermelho-claro : root.cor;
        text <=> root.texto;
        edited => { root.editado(); }
    }
    Text {
        text: root.ajuda;
        font-size: 11px;
        color: root.invalido ? Tema.vermelho-claro : (root.ajuda-aviso ? Tema.laranja : Tema.texto-2);
    }
}

// Uma verificação: marca (★ confere, ▲ não confere), nome e resultado.
component ItemIntegridade inherits HorizontalLayout {
    in property <string> nome;
    in property <string> resultado;
    in property <bool> bom;
    spacing: 12px;
    Rectangle {
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: root.bom ? #7fae4e24 : #c8261b2e;
        border-width: 1px;
        border-color: root.bom ? #7fae4e90 : #c8261bb0;
        Text {
            text: root.bom ? "★" : "▲";
            font-size: 14px;
            color: root.bom ? Tema.verde : Tema.vermelho-claro;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text { text: root.nome; color: Tema.texto; }
        Text {
            text: root.resultado;
            font-size: 12px;
            color: root.bom ? Tema.verde : Tema.vermelho-claro;
            overflow: elide;
        }
    }
}

// Explicação curta, em vermelho, de uma verificação que falhou.
component Falha inherits Text {
    font-size: 12px;
    color: Tema.vermelho-claro;
    wrap: word-wrap;
}

// Faixa do topo: miniatura com moldura, nome do save e a arte do jogo
// (Sheva de capuz vermelho do Mercenaries Reunion e Chris do Mercenaries),
// sobre a pedra da tela de Recordes.
component Faixa inherits Rectangle {
    height: 190px;
    background: #0b0706;
    border-width: 1px;
    border-color: Tema.linha;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../imagens/jogo/pedra.jpg");
        image-fit: cover;
    }
    // brilho vermelho atrás da miniatura
    Rectangle {
        x: -120px;
        y: -140px;
        width: 520px;
        height: 450px;
        background: @radial-gradient(circle, #7d120c66 0%, #7d120c22 45%, #00000000 70%);
    }
    // Sheva e Chris à direita; entram devagar quando a aba abre
    property <float> entrada: 0;
    init => { root.entrada = 1; }
    arte := Image {
        height: parent.height;
        width: self.height * 735 / 380;
        // na janela estreita a arte sai pela direita em vez de cobrir o nome
        x: max(parent.width - self.width - 16px, 430px) + (1 - root.entrada) * 40px;
        source: @image-url("../imagens/jogo/faixa_save.png");
        image-fit: contain;
        opacity: root.entrada;
        animate opacity, x { duration: 700ms; easing: ease-out; }
    }
    // traço vermelho na base, forte à esquerda
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: @linear-gradient(90deg, Tema.vermelho 0%, #c8261b55 45%, #c8261b00 100%);
    }

    HorizontalLayout {
        padding: 20px;
        padding-right: 0;
        spacing: 22px;
        alignment: start;

        // miniatura do save (ou a do jogo, se o save não tiver); no PC, o emblema
        Rectangle {
            width: 128px;
            height: 128px;
            background: #000000;
            border-width: 1px;
            border-color: #ffffff40;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000c0;
            Image {
                width: parent.width - 6px;
                height: parent.height - 6px;
                source: !Ponte.xbox ? @image-url("../imagens/jogo/bsaa.png")
                    : (Ponte.tem-miniatura ? Ponte.miniatura : Ponte.miniatura-jogo);
                image-fit: contain;
                opacity: !Ponte.xbox ? 0.6 : 1;
            }
            if Ponte.xbox && !Ponte.tem-miniatura && !Ponte.tem-miniatura-jogo: Text {
                text: "sem imagem";
                font-size: 11px;
                color: Tema.desativado;
            }
        }

        VerticalLayout {
            // até onde começa a arte, para o rosto do Chris ficar livre
            width: max(260px, arte.x - 128px - 62px);
            alignment: center;
            spacing: 8px;
            Text {
                text: !Ponte.xbox ? "SAVE DE PC" : (Ponte.nome-save-edit != "" ? Ponte.nome-save-edit : "SAVE SEM NOME");
                font-family: Tema.fonte-titulo;
                font-size: 26px;
                letter-spacing: 1.5px;
                color: #ffffff;
                overflow: elide;
            }
            Rectangle {
                width: 64px;
                height: 2px;
                background: Tema.vermelho;
            }
            if Ponte.xbox && Ponte.editando-nome: Campo {
                rotulo: "Nome no dashboard do Xbox · até 128 letras";
                texto <=> Ponte.nome-save-edit;
                invalido: Ponte.nome-save-invalido;
                ajuda: Ponte.nome-save-invalido ? "o nome não pode ficar vazio" : "";
                editado => { Ponte.campo-editado(); }
            }
            if !Ponte.editando-nome: Text {
                text: Ponte.xbox ? Ponte.nome-jogo + "  ·  Title ID " + Ponte.title-id + "  ·  Console ID " + Ponte.console-id
                    : Ponte.plataforma;
                font-size: Tema.fonte-pequena;
                color: Tema.texto-2;
                overflow: elide;
            }
            // RENOMEAR e o nome do arquivo; o caminho inteiro aparece com o mouse em cima
            if !Ponte.editando-nome || Ponte.xbox: HorizontalLayout {
                spacing: 14px;
                alignment: start;
                if Ponte.xbox: Botao {
                    pequeno: true;
                    texto: Ponte.editando-nome ? "OK" : "RENOMEAR";
                    clicado => { Ponte.editando-nome = !Ponte.editando-nome; }
                }
                if !Ponte.editando-nome: Text {
                    horizontal-stretch: 1;
                    text: arquivo.has-hover ? Ponte.caminho : Ponte.arquivo-nome;
                    font-size: 12px;
                    color: arquivo.has-hover ? Tema.texto : Tema.desativado;
                    vertical-alignment: center;
                    overflow: elide;
                    arquivo := TouchArea { }
                }
            }
        }
    }
}

// Na janela normal a aba cabe inteira; na janela pequena, rola.
export component TelaInformacoes inherits Rectangle {
    rolagem := ScrollView {
        width: parent.width;
        height: parent.height;
        horizontal-scrollbar-policy: always-off;
        // largura fixa na área visível, como na aba História
        VerticalLayout {
            width: rolagem.visible-width;
            alignment: start;
            spacing: 14px;
            padding-top: 10px;
            padding-bottom: 12px;

            Faixa { }

            // ---- dinheiro e data (os nomes do jogo)
            HorizontalLayout {
                spacing: 14px;
                Cartao {
                    horizontal-stretch: 1;
                    titulo: Ponte.xbox ? "GOLD" : "MONEY";
                    ValorGrande {
                        texto <=> Ponte.gold;
                        invalido: Ponte.gold-invalido;
                        ajuda: Ponte.gold-alto ? "acima do máximo do jogo (9.999.999)" : "máximo 9.999.999 no jogo";
                        ajuda-aviso: Ponte.gold-alto;
                        editado => { Ponte.campo-editado(); }
                    }
                }
                Cartao {
                    horizontal-stretch: 1;
                    titulo: "EXCHANGE POINTS";
                    ValorGrande {
                        texto <=> Ponte.points;
                        invalido: Ponte.points-invalido;
                        ajuda: Ponte.points-alto ? "acima do máximo do jogo (9.999.999)" : "máximo 9.999.999 no jogo";
                        ajuda-aviso: Ponte.points-alto;
                        editado => { Ponte.campo-editado(); }
                    }
                }
                Cartao {
                    horizontal-stretch: 1;
                    titulo: "DATA DO SAVE";
                    ValorGrande {
                        texto <=> Ponte.data;
                        cor: Tema.texto;
                    letras: 19;
                        invalido: Ponte.data-invalida;
                        ajuda: Ponte.data-invalida ? "use dd/mm/aaaa hh:mm:ss" : "dd/mm/aaaa hh:mm:ss";
                        editado => { Ponte.campo-editado(); }
                    }
                }
            }

            // ---- dono do save e integridade
            HorizontalLayout {
                spacing: 14px;
                Cartao {
                    horizontal-stretch: 1;
                    titulo: Ponte.xbox ? "PERFIL" : "CONTA STEAM";
                    if Ponte.xbox: HorizontalLayout {
                        spacing: 16px;
                        Campo {
                            horizontal-stretch: 1;
                            rotulo: "XUID · " + (Ponte.gamertag != "" ? Ponte.gamertag : "gamertag desconhecida");
                            texto <=> Ponte.profile-id;
                            invalido: Ponte.profile-invalido;
                            editado => { Ponte.campo-editado(); }
                        }
                        Campo {
                            horizontal-stretch: 2;
                            rotulo: "Device ID · 40 dígitos";
                            texto <=> Ponte.device-id;
                            invalido: Ponte.device-invalido;
                            editado => { Ponte.campo-editado(); }
                        }
                    }
                    if Ponte.xbox: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Botao { pequeno: true; texto: "COPIAR DE OUTRO SAVE…"; clicado => { Ponte.copiar-ids(); } }
                        Botao { pequeno: true; texto: "VOLTAR IDS"; clicado => { Ponte.voltar-ids(); } }
                        Botao { pequeno: true; texto: "LER PERFIL…"; clicado => { Ponte.ler-perfil(); } }
                    }
                    if Ponte.xbox: Text {
                        text: "Pasta no pendrive:  Content\\" + Ponte.profile-id + "\\" + Ponte.title-id + "\\00000001\\";
                        font-size: 12px;
                        color: Tema.texto-2;
                        overflow: elide;
                    }
                    if !Ponte.xbox: Campo {
                        rotulo: "Steam ID";
                        texto <=> Ponte.steam-id;
                        invalido: Ponte.steam-invalido;
                        editado => { Ponte.campo-editado(); }
                    }
                }
                Cartao {
                    min-width: 280px;
                    preferred-width: 340px;
                    horizontal-stretch: 0;
                    titulo: "INTEGRIDADE";
                    ItemIntegridade {
                        nome: "Checksum do jogo";
                        resultado: Ponte.checksum-ok ? "confere" : "não confere";
                        bom: Ponte.checksum-ok;
                    }
                    if Ponte.xbox: ItemIntegridade {
                        nome: "Hashes do pacote";
                        resultado: Ponte.hashes-ok ? "conferem" : "não conferem";
                        bom: Ponte.hashes-ok;
                    }
                    if Ponte.xbox: ItemIntegridade {
                        nome: "Assinatura";
                        resultado: Ponte.assinatura;
                        bom: Ponte.assinatura-ok;
                    }
                }
            }
            if !Ponte.checksum-ok: Falha { text: Ponte.checksum-texto; }
            if Ponte.xbox && !Ponte.hashes-ok: Falha { text: Ponte.hashes-texto; }
            if Ponte.xbox && !Ponte.assinatura-ok: Falha { text: Ponte.assinatura-texto; }
        }
    }
}
